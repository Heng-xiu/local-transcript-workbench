# ---------------------------------------------------------------------------
# local-transcript-workbench — frontend environment variables
#
# Copy to `.env` for local development. ALL values are optional: with none set
# the app runs fully against the in-browser mock API (mock mode).
#
# IMPORTANT: this is a frontend SPA. Never put LLM API keys or other secrets in
# any VITE_* variable — they are bundled into client code and shipped to the
# browser. Secrets live only in the self-hosted backend.
# ---------------------------------------------------------------------------

# Base URL of the self-hosted workbench backend.
# Leave empty to use the in-browser mock API. Set it to switch to the real API.
VITE_API_BASE_URL=

# Base URL of the meeting-api transcript service. Must include meeting-api's
# `/api` prefix, e.g. http://localhost:4001/api
# When set (hybrid mode), only transcript *reads* (list / get / audio / segments)
# go to meeting-api; everything else stays on the selected base adapter.
# Leave empty to keep transcript reads on the mock API.
VITE_MEETING_API_BASE_URL=

# Local LiveKit signalling server websocket URL (placeholder in MVP).
VITE_LIVEKIT_WS_URL=ws://localhost:7880

# Backend endpoint that mints short-lived LiveKit access tokens (placeholder).
VITE_LIVEKIT_TOKEN_ENDPOINT=http://localhost:8080/api/livekit/token

# Which provider the backend routes generation through: local | openrouter.
# The frontend only displays this; provider selection + keys live in the backend.
VITE_AI_PROVIDER_MODE=local

# Backend endpoint that runs LLM generation jobs (unused while mocking).
VITE_AI_GENERATION_ENDPOINT=http://localhost:8080/api/ai/generate

# Backend endpoint that streams recording audio assets (unused while mocking).
VITE_RECORDING_ASSET_ENDPOINT=http://localhost:8080/api/recordings

# Error monitoring via self-hosted GlitchTip (Sentry-compatible).
# DSN is a public value (safe to expose in a SPA). Leave blank to disable.
# Get the DSN from the GlitchTip UI: the "workbench" project's Client Keys (DSN).
# See infra/glitchtip/README.md.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0
