    "@tanstack/react-store": "^0.11.0",
    "@tanstack/react-virtual": "^3.14.2",
    "@tanstack/router-plugin": "^1.132.0",
    "@tanstack/store": "^0.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
